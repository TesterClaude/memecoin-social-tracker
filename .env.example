# Telegram alert bot — create via @BotFather, then add the bot to your private
# channel as admin. Chat ID of a private channel looks like -100xxxxxxxxxx
# (forward a channel post to @userinfobot or use getUpdates to find it).
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
TELEGRAM_ALERT_CHAT_ID=-1001234567890
